---
// format: "+ client (year) / middle / field." -> split ke 3 kolom
const clients = {
    "+ reweb+ (2026) / liberte / wix development.":"https://reweb.jp",
    "+ sitelead (2026) / liberte / wix development.":"",
    "+ aiko-dc (2026) / redigiform / web development.":"https://new.aiko-dc.com/",
    "+ mquest (2026) / redigiform / wordpress development.":"https://m-quest.net/",
    "+ emir pasha (2026) / afteranother / web designs.":"",
    "+ shane howell (2026) / afteranother / web designs.":"",
    "+ tnbaura (2025, 2026) / afteranother / web designs.":"https://tnbaura.vc",
    "+ evan wijaya (2025) / afteranother / web designs.":"https://evanwijaya.com",
    "+ abon gulung pawai (2025) / afteranother / web designs.":"",
    "+ daastech (2025) / afteranother / web designs.":"",
    "+ quicksite (2025) / afteranother / web designs.":"https://quicksite.ai",
    "+ teachflex (2024) / foundstrap studio / web designs.":"https://dribbble.com/shots/24903374-Teachflex-Inclusive-Bootcamp",
    "+ stylenxt (2024) / foundstrap studio / web designs.":"https://dribbble.com/shots/24903611-STYLENXT-Augmented-Reality-Fashion-Commerce",
    "+ natur (2024) / foundstrap studio / web designs.":"https://dribbble.com/shots/24903334-Natur-Eco-friendly-Products",
    "+ hanami (2024) / foundstrap studio / web designs.":"https://dribbble.com/shots/24903057-Hanami-Bloom-Flower-Shop-Website",
    "+ finku (2021-2023) / finku / web designs.":"https://finku.id/",
    "+ ubicon (2022) / unhas / web development.":"https://ubicon.unhas.ac.id/"
};
---

<style lang="sass">
  ul
    display: flex
    flex-direction: column
    width: 100%
  li, li a
    display: grid
    grid-template-columns: repeat(3, 1fr)
    width: 100%
  li a
    grid-column: 1 / -1
  p:nth-child(2)
    text-align: center
  p:nth-child(3)
    text-align: right
</style>

<p class="client-title transparent">clients:</p>
<ul>
    {Object.entries(clients).map(([clientName, clientLink]) => {
        const [name, middle, field] = clientName.replace(/\.$/, "").split(" / ");
        const cols = (
            <>
                <p>{name}</p>
                <p>/ {middle} /</p>
                <p>{field}</p>
            </>
        );
        return (
            <li class="client-item transparent">
                {clientLink ? (
                    <a href={clientLink} target="_blank" rel="noopener noreferrer">{cols}</a>
                ) : cols}
            </li>
        );
    })}
</ul>
