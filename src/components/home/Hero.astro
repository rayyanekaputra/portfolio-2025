---

---
<style lang="sass">
  @use "../../styles/_colors.sass" as colors
  .splash, .hero
    display: flex
    flex-direction: column
    row-gap: 8px
    .splash-desc, .hero-desc
      height: 400px
      max-width: 556px
      font-weight: 600
      color: var(--strong)
      @media (max-width: 1440px) 
        height: 120px
  h2
    @media (max-width: 1440px)
      font-size: 16px
      line-height: 120%
    font-size: 24px
    font-weight: 400
    padding: 0
    margin: 0
    color: var(--fg)
  .home-name
    cursor: pointer
    transition: color 0.25s ease, text-shadow 0.25s ease
    &:hover
      color: var(--light)
      text-shadow: 0 0 6px var(--glow), 0 0 18px var(--glow)
  #desc-typer
    font-weight: 400
  .splash-text-container
    display: flex
</style>
<div class="splash">
  <h2>/home/<span class="home-name" title="stack the polaroids">rayyanekaputra</span></h2>
  <div class="splash-text-container">
    <h2 id="loading-text" class="splash-desc"></h2>
    <h2 class="hero-desc display-none transparent">
      security, networking, and web. senior engineer with 5 years experience in tech.
      <span
        id="desc-typer"
        class="typer"
        data-colors="var(--accent)"
        data-delay="45"
        data-words=" , certified. , proven. , careful."
        data-delete-delay="4000"></span>
      <span class="cursor" data-owner="desc-typer" data-cursor-display="_"
      ></span>
    </h2>
  </div>
</div>
</script>

