---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/home/Hero.astro";
import Certification from "../components/home/Certification.astro";
import Jobs from "../components/home/Jobs.astro";
import Polaroids from "../components/home/Polaroids.astro";
import Projects  from "../components/home/Projects.astro";
import Clients from "../components/home/Clients.astro";
import Grain from "../components/Grain.astro";
---

<style lang="sass">
  section
    display: flex
    flex-direction: column
    justify-content: space-between
    height: 100vh
  .first
    position: relative
    overflow-x: clip
  .top-row
    display: flex
    width: 100%
    justify-content: space-between
    padding: 40px
  .bottom-row
    display: flex
    column-gap: 40px
    width: fit-content
    flex-direction: row
    padding: 40px
    @media (max-width: 1440px)
      flex-direction: column
      row-gap: 16px
    ul
      flex-direction: column
  .clients-row
    display: flex
    flex-direction: column
    width: 100%
    padding: 0 40px 40px
    ul
      flex-direction: column
      width: 100%
  .mobile-menu-overlay
    position: fixed
    width: 100vw
    height: 100vh
    background-color: rgba(127 214 119/ 80%)
    // background-color: black
    backdrop-filter: blur(1px)
    z-index: 99999
    clip-path: circle(100% at 50% 50%)

    display: flex
    padding: 40px
    flex-direction: column
    justify-content: flex-end
    p
      font-size: 24px
      @media (min-width: 1440px)
        display: none
</style>

<Layout pageTitle="rayyan eka putra | security and internet engineer">
  <section class="first">
    <div class="mobile-menu-overlay">
      <p>
        <a href="https://www.linkedin.com/in/rayyan-eka-putra/">.linkedin</a>
      </p>
      <p><a href="https://www.instagram.com/rayyanekaputra">.instagram</a></p>
      <p><a href="https://github.com/rayyanekaputra/">.github</a></p>
      <p><a href="https://dribbble.com/rayyanekaputra/">.dribbble</a></p>
    </div>
    <div class="top-row">
      <Hero />
      <Navbar
        navs={[
          {
            name: ".linkedin",
            link: "https://www.linkedin.com/in/rayyan-eka-putra/",
          },
          {
            name: ".instagram",
            link: "https://www.instagram.com/rayyanekaputra",
          },
          { name: ".github", link: "https://github.com/rayyanekaputra/" },
          { name: ".dribbble", link: "https://dribbble.com/rayyanekaputra" },
        ]}
      />
    </div>
    <div class="bottom-row">
      <Certification />
      <Jobs />
      <Projects />
    </div>
    <div class="clients-row">
      <Clients />
    </div>
    <Grain />
    <Polaroids />
  </section>
</Layout>
<script>
  //@ts-nocheck
  //ANIMATION SCRIPTS
  import {
    animate,
    createTimeline,
    stagger,
    utils,
    createDraggable,
  } from "animejs";
  import LocomotiveScroll from "locomotive-scroll";

  //SMOOTH SCROLL (locomotive v5 = lenis). autoStart false --> scroll terkunci selama intro, start() pas polaroids muncul
  const locoScroll = new LocomotiveScroll({ autoStart: false });
  //lenis cuma ukur ulang tinggi halaman kalau ukuran elemen berubah, transform (geser polaroid) tidak kehitung --> ukur manual
  const refreshDelay = 600; //ms tunggu sebelum ukur ulang, biar tidak kaget pas polaroid dilempar bolak-balik
  let refreshTimer;
  const refreshScrollHeight = () => {
    clearTimeout(refreshTimer); //lempar lagi sebelum waktunya --> hitung ulang dari awal
    refreshTimer = setTimeout(() => locoScroll.lenisInstance?.resize(), refreshDelay);
  };

  //RITME STAGGER ala motion graphic: jarak antar item lambat - cepat sekali - cepat - lambat
  //(ini ngatur delay, bukan posisi. angka ke-3 & ke-4 = seberapa halus ujungnya)
  const staggerRhythm = { ease: "cubicBezier(0, 0.5, 0.8, 0.4)" };

  //JEDA ANTAR ANIMASI: berapa ms animasi berikutnya mulai sebelum yang sebelumnya selesai
  const sectionOverlap = 500;
  const overlapPrev = `<-=${sectionOverlap}`;

  /*
  TIMELINE ANIMATION FOR HOME
  */
  let mobileMenuOverlay = document.querySelector(
    ".mobile-menu-overlay",
  ) as HTMLElement;
  let loadingTextEl = document.querySelector("#loading-text") as HTMLElement; //as HTMLElement gara2 typescript, baekji kalau tanpa itu
  let heroDescEl = document.querySelector(".hero-desc") as HTMLElement;
  let certItemsEl = document.querySelectorAll(".cert-item");
  let certTitleEl = document.querySelector(
    ".certification-title",
  ) as HTMLElement;

  let jobItemsEl = document.querySelectorAll(".job-item");
  let expTitleEl = document.querySelector(".experience-title") as HTMLElement;
  
  let projectItemsEl = document.querySelectorAll(".project-item");
  let projectTitleEl = document.querySelector(".project-title") as HTMLElement;

  let clientItemsEl = document.querySelectorAll(".client-item");
  let clientTitleEl = document.querySelector(".client-title") as HTMLElement;


  // Store all drag instances in an array, btw objects, array, dan functions kalau disimpan dalam variable, itu pass-by-reference
  const dragInstances = [];

  //DRAGGING FUNCTION --> dipanggil di onComplete animasi Polaroids
  let polaroidCardsEl = document.querySelectorAll(".polaroid-card");
  const dragPolaroids = (el) =>
    createDraggable(el, {
      // container: ".first", //disabling this so the polaroids can be pushed off the side
      onSettle: refreshScrollHeight, //polaroid dilempar ke bawah --> halaman bisa lebih tinggi
    });

  let isMobileMenuOpen: boolean = false;
  const openMobileMenuAnim = () => {
    console.log("TERKLIK");
    animate(mobileMenuOverlay, {
      clipPath: `circle(${isMobileMenuOpen ? "0%" : "100%"} at 50% 50%)`,
      ease: "inOutExpo",
    });
    isMobileMenuOpen ? locoScroll.start() : locoScroll.stop(); //kunci scroll selama menu terbuka
    isMobileMenuOpen = !isMobileMenuOpen;
  };

  //MORE BUTTON --> RESET dan BUKA MENU
  let btnNavbarMobile = document.querySelector("button.navbar-mobile-btn");
  const navbarMoreButton = (draggingInstances) => {
    const handleMobileClick = () => {
      // draggingInstances.forEach((draggingInstance) => draggingInstance.reset());
      openMobileMenuAnim();
    };
    btnNavbarMobile?.removeEventListener("click", handleMobileClick);
    btnNavbarMobile?.addEventListener("click", handleMobileClick);
    /*
    MOBILE MENU ANIMATION
    */
  };

  let tl = createTimeline({
    // duration: 1200,
  });
  tl.add(mobileMenuOverlay, {
    clipPath: "circle(0% at 50% 50%)",
    ease: "inOutExpo",
    delay: 300,
  })
    //ANIMASI LOADING
    .add(
      loadingTextEl,
      {
        innerText: "initializing " + [100] + "%",
        modifier: utils.roundPad(0),
        ease: "inOutExpo",
        duration: 2000,
        delay: 400,
        onComplete: () => heroDescEl.classList.remove("display-none"),
      },
      "<<",
    )
    // //HAPUS LOADING
    .add(loadingTextEl, {
      opacity: 0,
      ease: "inOutExpo",
      onComplete: () => {
        // console.log(heroDescEl);
        loadingTextEl.classList.add("transparent", "display-none");
      },
    })
    //MASUKKAN HERO DESC
    .add(heroDescEl, {
      opacity: 1,
      ease: "inOutExpo",
      onComplete: () => {
        // console.log(heroDescEl);
      },
    }) //no overlap: loading-text masih makan tempat di flex row sampai display-none
    //MASUKKAN CERTIFICATION TITLE
    .add(certTitleEl, {
      opacity: 1,
      ease: "inOutExpo",
      onComplete: () => {
        certTitleEl.classList.remove("transparent");
      },
    }, overlapPrev)
    //MASUKKAN CERTIFICATIONS
    .add(certItemsEl, {
      opacity: 1,
      delay: stagger(100, staggerRhythm),
      ease: "inOutExpo",
      onComplete: () => {
        certItemsEl.forEach((certItemEl) => {
          //remove satu2 njo kelas transparentna
          // console.log(certItemEl);
          certItemEl.classList.remove("transparent");
        });
      },
    }, overlapPrev)
    //MASUKKAN EXPERIENCE TITLE
    .add(expTitleEl, {
      opacity: 1,
      ease: "inOutExpo",
      onComplete: () => {
        expTitleEl.classList.remove("transparent");
      },
    }, overlapPrev)
    //MASUKKAN JOB
    .add(jobItemsEl, {
      opacity: 1,
      delay: stagger(100, staggerRhythm),
      ease: "inOutExpo",
      onComplete: () => {
        jobItemsEl.forEach((jobItemEl) => {
          //remove satu2 njo kelas transparentna
          // console.log(certItemEl);
          jobItemEl.classList.remove("transparent");
        });
      },
    }, overlapPrev)
    //MASUKKAN PROJECTS TITLE
    .add(projectTitleEl, {
      opacity: 1,
      ease: "inOutExpo",
      onComplete: () => {
        projectTitleEl.classList.remove("transparent");
      },
    }, overlapPrev)
    //MASUKKAN PROJECT
    .add(projectItemsEl, {
      opacity: 1,
      delay: stagger(100, staggerRhythm),
      ease: "inOutExpo",
      onComplete: () => {
        projectItemsEl.forEach((projectItemEl) => {
          //remove satu2 njo kelas transparentna
          // console.log(certItemEl);
          projectItemEl.classList.remove("transparent");
        });
      },
    }, overlapPrev)
    //MASUKKAN CLIENTS TITLE
    .add(clientTitleEl, {
      opacity: 1,
      ease: "inOutExpo",
      onComplete: () => {
        clientTitleEl.classList.remove("transparent");
      },
    }, overlapPrev)
    //MASUKKAN CLIENT
    .add(clientItemsEl, {
      opacity: 1,
      delay: stagger(100, staggerRhythm),
      ease: "inOutExpo",
      onComplete: () => {
        clientItemsEl.forEach((clientItemEl) => {
          clientItemEl.classList.remove("transparent");
        });
      },
    }, overlapPrev)

    //POLAROIDS MUNCUL
    .add(polaroidCardsEl, {
      opacity: 1,
      delay: stagger(100, staggerRhythm),
      ease: "inOutExpo",
      onComplete: () => {
        //POLAROIDS DRAGGABLE
        polaroidCardsEl.forEach((cardEl) => {
          const dragMe = dragPolaroids(cardEl);
          dragInstances.push(dragMe); // Store the instance's reference
        });
        locoScroll.start(); //intro selesai --> boleh scroll
      },
    }, overlapPrev);
  navbarMoreButton(dragInstances); // Pass all instances

  //KLIK NAMA --> TUMPUK POLAROIDS (desktop & mobile)
  //semua kartu ditarik ke titik tengah, tiap kartu turun sedikit biar kelihatan bertumpuk
  const stackOffset = 8; //px jarak turun tiap kartu
  let isStacking = false; //cegah klik dobel selama animasi jalan
  const stackPolaroids = () => {
    if (!dragInstances.length || isStacking) return; //intro belum selesai / animasi lagi jalan
    isStacking = true;
    const homes = dragInstances.map((dragInstance) => {
      const rect = dragInstance.$target.getBoundingClientRect();
      return {
        x: rect.left + rect.width / 2 - dragInstance.x, //posisi asli tanpa geseran drag
        y: rect.top + rect.height / 2 - dragInstance.y,
      };
    });
    const centerX = homes.reduce((sum, h) => sum + h.x, 0) / homes.length;
    const centerY = homes.reduce((sum, h) => sum + h.y, 0) / homes.length;
    const middle = (homes.length - 1) / 2;
    const proxies = dragInstances.map((dragInstance, i) => ({
      x: dragInstance.x,
      y: dragInstance.y,
      toX: centerX - homes[i].x,
      toY: centerY - homes[i].y + (i - middle) * stackOffset,
    }));
    animate(proxies, {
      x: (p) => p.toX,
      y: (p) => p.toY,
      delay: stagger(60, staggerRhythm),
      ease: "inOutExpo",
      duration: 900,
      onUpdate: () =>
        proxies.forEach((p, i) => dragInstances[i].setX(p.x).setY(p.y)),
      onComplete: () => movePileToTop(proxies, homes),
    });
  };

  //SETELAH BERTUMPUK --> PINDAH TUMPUKAN KE ANTARA HEADER & NAVBAR, rata atas
  //(mobile: navbar-ul hidden, jadi antara header & tombol "more")
  const getPileSpot = () => {
    const headerRect = document.querySelector(".splash").getBoundingClientRect();
    const navbarUl = document.querySelector("ul.navbar-ul");
    const navEl = navbarUl.getClientRects().length ? navbarUl : btnNavbarMobile;
    const navRect = navEl.getBoundingClientRect();
    return {
      centerX: (headerRect.right + navRect.left) / 2, //tengah-tengah celahnya
      top: Math.min(headerRect.top, navRect.top),
    };
  };
  const movePileToTop = (proxies, homes) => {
    const spot = getPileSpot();
    const cardRect = dragInstances[0].$target.getBoundingClientRect();
    const middle = (proxies.length - 1) / 2;
    const pileX = spot.centerX;
    const pileY = spot.top + cardRect.height / 2 + middle * stackOffset; //kartu pertama rata atas dengan header
    proxies.forEach((p, i) => {
      p.toX = pileX - homes[i].x;
      p.toY = pileY - homes[i].y + (i - middle) * stackOffset;
    });
    animate(proxies, {
      x: (p) => p.toX,
      y: (p) => p.toY,
      delay: stagger(60, staggerRhythm),
      ease: "inOutExpo",
      duration: 900,
      onUpdate: () =>
        proxies.forEach((p, i) => dragInstances[i].setX(p.x).setY(p.y)),
      onComplete: () => {
        isStacking = false;
        refreshScrollHeight(); //tumpukan pindah ke atas --> halaman bisa lebih pendek
      },
    });
  };
  let homeNameEl = document.querySelector(".home-name");
  homeNameEl?.addEventListener("click", stackPolaroids);
</script>
<script src="../scripts/typer.js"></script>
